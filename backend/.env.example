# --- Supabase ---
# Project Settings -> API in your Supabase dashboard
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the "service_role" key here (server-side only). NEVER expose this
# key in the frontend/browser — it bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Optional: outgoing email notifications for /api/contact ---
# Leave unset to skip sending emails (inquiries are still saved to Supabase).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_EMAIL=
